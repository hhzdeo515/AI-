{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:demo",
  "outputDirectory": "out",
  "rewrites": [
    { "source": "/_AMapService/:path*", "destination": "/api/amap-proxy?path=:path*" }
  ],
  "functions": {
    "api/intent-cloud.js": { "maxDuration": 30 },
    "api/translate.js": { "maxDuration": 20 },
    "api/amap-proxy.js": { "maxDuration": 20 }
  }
}
