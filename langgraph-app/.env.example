# LangGraph 版本配置。与 assistant-lite 独立：自己的数据目录与检查点库。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_TEXT=qwen-plus
MODEL_VISION=qwen-vl-max
MODEL_ASR=qwen3-asr-flash
MODEL_TTS=cosyvoice-v1
TTS_VOICE=longxiaochun

# ---------- 监听与访问口令 ----------
# WEB_HOST：127.0.0.1 只允许本机；0.0.0.0 允许局域网（手机连同一 WiFi 可开）
WEB_HOST=127.0.0.1
WEB_PORT=8802

# ACCESS_TOKEN：Web 访问口令。**留空 = 完全不鉴权**，只适合本机单机使用。
#
# 一旦要让局域网或公网访问，必须设置它——否则任何能连上该地址的人都可以：
#   1) 用你的 DASHSCOPE_API_KEY 调模型（消耗你的额度）
#   2) 读你 data/ 目录下的资料库、题解、会议纪要
#   3) 通过 /api/export 下载你的归档文件
#
# 生成一个：python -c "import secrets;print(secrets.token_urlsafe(12))"
# 或用：.\start.ps1 -LAN（口令没设时它会直接拒绝启动）
ACCESS_TOKEN=

# ---------- 执行后端 ----------
# python = 本地场景节点；dify = 转发给 ../dify-multiagent/ 的工作流
EXEC_BACKEND=python
DIFY_BASE_URL=http://127.0.0.1/v1
DIFY_API_KEY=
DIFY_TIMEOUT=300
DIFY_FALLBACK_LOCAL=1

# ---------- 会议转写 ----------
# 定制热词表：一行一个词（# 注释）。默认读 data/hotwords.txt，
# 文件不存在时用代码内置的默认表。领域词听错（「具身」听成「巨身」）靠它治。
# HOTWORDS_PATH=data/hotwords.txt
# 热词权重 1–5，常用 4；权重过大会干扰其他词的识别
# HOTWORD_WEIGHT=4
# 长音频降级分片时每片秒数（说话人分离走整段，不受此项影响）
# ASR_CHUNK_SECONDS=240

# ---------- 端侧契约 ----------
# 端侧判定可信阈值（设计文档 §3.2）
DEVICE_CONFIDENCE_FLOOR=0.75
