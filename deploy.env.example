# Copy to deploy.env on the deployment host and fill in the values.
# Generate ACCESS_TOKEN with: python -c "import secrets; print(secrets.token_urlsafe(24))"
ACCESS_TOKEN=
TASK_WORKERS=2
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_TEXT=qwen-plus
MODEL_VISION=qwen-vl-max
EXAM_MODEL=qwen3.8-flash
EXAM_INDEPENDENT_MODEL=qwen3.7-plus
EXAM_REVIEW_MODEL=qwen3.8-max-0902
MODEL_ASR=qwen3-asr-flash
MODEL_TTS=cosyvoice-v1

# Optional JEV decision service
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
JEV_MIN_CONFIDENCE=0.75
JEV_TIMEOUT=30
