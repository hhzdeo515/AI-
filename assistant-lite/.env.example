# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会入库。
# 阿里云百炼控制台 -> API-KEY -> 创建我的 API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 百炼 OpenAI 兼容接口（一般不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型：文本 / 视觉 / 语音识别
MODEL_TEXT=qwen-plus
MODEL_VISION=qwen-vl-max
MODEL_ASR=qwen3-asr-flash

# 单次模型调用超时（秒）
REQUEST_TIMEOUT=120

# ---------- 外部工具 ----------
# 约定：新增安装物一律放 E 盘，不占系统盘。
# 长会议转写需要把音频切片，ffmpeg 就装在这里（默认路径见下）。
TOOLS_DIR=E:\AI智能助手\tools
# ffmpeg 可执行文件。留空则按 TOOLS_DIR\ffmpeg\bin -> PATH 顺序自动查找。
FFMPEG_PATH=

# 单个 ASR 分片的目标时长（秒）。长会议必须分段转写，否则单次调用会超限。
ASR_CHUNK_SECONDS=240

# ---------- Dify 执行后端（可选）----------
# 注意：路由权威**始终在本地 orchestrator**（零 token、可测、端侧判对率统计依赖它）。
# 这里只切换「场景 Agent 在哪执行」，不切换路由。
#   local = 本仓库 Python Agent（默认）
#   dify  = 转发给 Dify 工作流（见 ../dify-multiagent/）
EXEC_BACKEND=local
# Dify 应用 Service API（末尾 /v1）
DIFY_BASE_URL=http://127.0.0.1/v1
# Dify 应用 API Key，app- 开头。可在 Dify 应用「访问 API」页创建。
DIFY_API_KEY=
# 转发超时（秒）：Dify 侧含 LLM 推理，放宽一些
DIFY_TIMEOUT=300
# 转发失败是否回退本地 Agent。1=回退（更稳），0=直接报错（便于暴露问题）
DIFY_FALLBACK_LOCAL=1
