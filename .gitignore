# ---- 运行时数据与密钥（绝不入库） ----
assistant-lite/data/
.env
**/.env
!**/.env.example
# Dify 控制台令牌是**活凭据**（access / csrf / refresh），绝不能入库。
# 这些文件曾放在这里且未被忽略，上线前扫描才发现——差一步就推上公开仓库。
.workbuddy-ai/tmp/

# ---- 新项目的运行时数据 ----
dify-multiagent/.build/
langgraph-app/data/

# ---- Python ----
__pycache__/
*.py[cod]
*.log

# ---- 外部工具（安装物不入库，体积大） ----
# 约定：ffmpeg、独立 Python 包等都装在这里，代码通过 config.TOOLS_DIR 引用
tools/
.venv/
venv/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# ---- 旧项目（dify-assistant）私有资产 ----
dify-assistant/.private/
dify-assistant/.deps/
dify-assistant/data/
dify-assistant/*.private.yaml
dify-assistant/reference-*.yaml

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 一次性探测脚本的残留 ----
.probe_*.txt
.probe_*.py
*.prd_q.png
